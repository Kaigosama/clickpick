# Server
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace_with_long_random_secret

# SMTP for email verification / password reset codes
# Use your real SMTP account (sender). Recipient is always the user's email.
# Example for Gmail App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=ClickPick <yourgmail@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: enable /api/auth/test-email in production
ALLOW_EMAIL_TEST_ENDPOINT=false

# SMS (optional)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
